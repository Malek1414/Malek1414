<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.malekhassan.profile-stats</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/malekhassan/Desktop/Projects/Malek1414/automation/refresh.sh</string>
	</array>

	<!-- Mondays at 09:00. If the Mac is asleep then, launchd runs it once on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/malekhassan/Library/Logs/profile-stats/refresh.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/malekhassan/Library/Logs/profile-stats/refresh.err.log</string>
</dict>
</plist>
